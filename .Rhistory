}
}
# ---- Scatter point colouring (Sector -> Gender -> Risk) ----
point_var <- NULL
point_label <- NULL
point_palette <- NULL
if (sum(!is.na(dat$sector)) >= 50) {
point_var <- "sector"; point_label <- "Sector"; point_palette <- sect_colors
} else if (sum(!is.na(dat$gender)) >= 50) {
point_var <- "gender"; point_label <- "Gender"; point_palette <- gender_colors
} else if (!is.null(risk_tbl)) {
point_var <- "risk_band"; point_label <- "Segment"; point_palette <- band_colors_5
}
# ============================================================================
# ITEM-LEVEL DIAGNOSTICS (professional labeling, no non-Likert fields)
# ============================================================================
item_diag <- NULL
if (length(num_cols) >= 5) {
item_label_of <- function(col) {
stem <- col %>% str_remove("_num$") %>% str_remove("^q[0-9]+_[0-9]+_")
stem <- str_remove(stem, "^([0-9]+[_ ]*)+")      # Remove leading numbers
stem <- str_replace_all(stem, "_", " ")
stem <- str_squish(stem)                          # Remove extra spaces
stem <- str_trim(stem)                            # Trim edges
# Remove any remaining numeric prefixes or suffixes
stem <- gsub("^\\d+\\.?\\s*", "", stem)          # Remove "1. ", "1) ", etc.
stem <- gsub("\\s*\\d+$", "", stem)              # Remove trailing numbers
stem <- str_squish(stem)
lbl <- str_to_sentence(stem)
if (nchar(lbl) < 2) return(col)
lbl
}
item_diag <- tibble(var = num_cols) %>%
mutate(
prefix  = str_extract(var, "^q[0-9]+_[0-9]+"),
idx_var = paste0("idx_", prefix),
Dimension = unname(LAB[idx_var]),
Dimension = ifelse(is.na(Dimension), "Other", Dimension),
Statement = map_chr(var, item_label_of),
N = map_int(var, ~ sum(!is.na(dat[[.x]]))),
Mean = map_dbl(var, ~ mean(dat[[.x]], na.rm = TRUE)),
`Agreement %` = map_dbl(var, function(cl) {
v <- dat[[cl]]; v <- v[!is.na(v)]
if (length(v) == 0) NA_real_ else round(100 * mean(v >= 4), 1)
}),
`Disagreement %` = map_dbl(var, function(cl) {
v <- dat[[cl]]; v <- v[!is.na(v)]
if (length(v) == 0) NA_real_ else round(100 * mean(v <= 2), 1)
}),
`Net Sentiment` = round((`Agreement %` - `Disagreement %`), 1),
`Performance Index` = round(Mean * 20, 1),
Correlation = map_dbl(var, function(cl) {
both <- !is.na(dat[[cl]]) & !is.na(dat$idx_overall)
if (sum(both) < 20) return(NA_real_)
tryCatch(cor(dat[[cl]][both], dat$idx_overall[both]),
error = function(e) NA_real_)
})
) %>%
filter(N >= 30, !is.na(`Net Sentiment`))
item_diag$Statement <- make.unique(item_diag$Statement)
if (nrow(item_diag) == 0) item_diag <- NULL
}
avg_perf <- if (!is.null(item_diag)) mean(item_diag$`Performance Index`, na.rm = TRUE) else NA
avg_corr <- if (!is.null(item_diag)) mean(item_diag$Correlation, na.rm = TRUE) else NA
if (!is.null(item_diag)) {
item_diag <- item_diag %>%
mutate(Priority = case_when(
`Performance Index` <  avg_perf & Correlation >= avg_corr ~ "Priority",
`Performance Index` >= avg_perf & Correlation >= avg_corr ~ "Maintain",
`Performance Index` <  avg_perf & Correlation <  avg_corr ~ "Monitor",
TRUE ~ "Optimize"
))
}
valueBox(comma(total_students), icon = "fa-users", color = INK)
valueBox(ifelse(is.na(n_institutions), "N/A", comma(n_institutions)),
icon = "fa-building", color = MUTED)
valueBox(ifelse(is.na(avg_overall), "N/A", paste0(avg_overall, "/100")),
icon = "fa-check-circle", color = HIGH)
valueBox(n_indices, icon = "fa-chart-bar", color = MID)
if (!is.null(pillar_tbl)) {
dt <- datatable(pillar_tbl %>% select(-contains("var")),
rownames = FALSE,
options = list(dom = "t", pageLength = 20, scrollX = TRUE)) %>%
formatStyle("Pillar", fontWeight = styleEqual("Overall Experience", "bold"),
fontSize = "13px") %>%
formatStyle("Variance from Overall",
color = styleInterval(0, c(LOW, HIGH)),
fontWeight = "bold") %>%
formatStyle("Rating",
backgroundColor = styleEqual(
c("Critical", "Needs Improvement", "Satisfactory", "Good", "Excellent"),
c("#F6D9DA", "#FBEAD2", "#FFF4D6", "#DCEEE7", "#C8E6D9")))
dt
} else {
datatable(data.frame(Note = "Insufficient data to generate dimension indices"),
rownames = FALSE, options = list(dom = "t"))
}
knitr::opts_chunk$set(echo = FALSE, warning = FALSE, message = FALSE)
# ---- Auto-install any missing packages -----------------------------------
required_pkgs <- c("flexdashboard", "tidyverse", "readxl", "janitor",
"plotly", "DT", "scales")
for (pkg in required_pkgs) {
if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
}
library(flexdashboard)
library(tidyverse)
library(readxl)
library(janitor)
library(plotly)
library(DT)
library(scales)
set.seed(2026)
# ================================================================ PALETTE ===
INK   <- "#14202E"
MUTED <- "#7A8794"
LOW   <- "#B3202C"
MID   <- "#E8B33C"
HIGH  <- "#12715A"
sect_colors  <- c(Public = "#2C5F8A", Private = "#D9772E")
gender_colors <- c(Male = "#2C5F8A", Female = "#D9772E")
band_colors_5 <- c("Critical" = "#8C1720", "At risk" = "#C75B3F",
"Stable" = "#D9B23C", "Thriving" = "#5FA88E",
"Excelling" = "#12715A")
# ---- Professional horizontal-bar builder (no numbering) ------------------
pro_hbar <- function(df, label_col, value_col, text_col, range_min, range_max,
color_low, color_mid, color_high, hover_template,
diverging = FALSE, text_size = 11, left_margin = 260,
x_title = "") {
vals <- df[[value_col]]
cats <- make.unique(as.character(df[[label_col]]))
ord  <- order(vals)
labs <- factor(cats, levels = cats[ord])
txts <- df[[text_col]]
txt_pos <- if (diverging) ifelse(vals >= 0, "middle right", "middle left") else "middle right"
plot_ly() %>%
add_bars(x = vals, y = labs, orientation = "h",
marker = list(color = vals,
colorscale = list(c(0, color_low), c(0.5, color_mid), c(1, color_high)),
cmin = range_min, cmax = range_max, showscale = FALSE),
hovertemplate = hover_template, showlegend = FALSE) %>%
add_trace(x = vals, y = labs, type = "scatter", mode = "text",
text = txts, textposition = txt_pos,
textfont = list(size = text_size, color = INK, family = "Arial"),
hoverinfo = "skip", showlegend = FALSE) %>%
layout(
xaxis = list(title = x_title, range = c(range_min, range_max), autorange = FALSE,
zeroline = diverging, zerolinewidth = 2, zerolinecolor = MUTED,
showgrid = TRUE, gridwidth = 1, gridcolor = "#F0F0F0"),
yaxis = list(title = "", tickfont = list(size = 11)),
margin = list(l = left_margin, r = 70, t = 10, b = 46),
showlegend = FALSE,
font = list(family = "Arial, sans-serif")
)
}
# ============================================================================
# LOAD & CLEAN DATA
# ============================================================================
dat <- read_excel("Book1.xlsx") %>% clean_names()
# Remove personal identifiers
dat <- dat %>%
select(-matches("name|respondent_id|timestamp|email|phone|enrollment|roll_no|student_id",
ignore.case = TRUE))
# Remove rows with >60% missing data and duplicates
dat <- dat[rowMeans(is.na(dat)) <= 0.6, ]
dat <- dat[!duplicated(dat), ]
# ---- Detect key demographic columns ---------------------------------------
sector_col <- grep("sector|institution_type", names(dat), value = TRUE)[1]
gender_col <- grep("gender|sex", names(dat), value = TRUE)[1]
univ_col   <- grep("university_reported|university|institution", names(dat), value = TRUE)[1]
field_col  <- grep("field_group|discipline|faculty|program|field", names(dat), value = TRUE)[1]
age_col    <- grep("^q.*age|^age", names(dat), value = TRUE)[1]
# Standardize sector
if (!is.na(sector_col)) {
s <- tolower(trimws(as.character(dat[[sector_col]])))
s[grepl("govt|government|public|federal", s)] <- "Public"
s[grepl("pvt|private", s)] <- "Private"
s[!s %in% c("Public", "Private")] <- NA
dat$sector <- s
} else {
dat$sector <- NA
}
# Standardize gender
if (!is.na(gender_col)) {
g <- tolower(trimws(as.character(dat[[gender_col]])))
g[g %in% c("m", "male")] <- "Male"
g[g %in% c("f", "female")] <- "Female"
g[!g %in% c("Male", "Female")] <- NA
dat$gender <- g
} else {
dat$gender <- NA
}
# Standardize university
if (!is.na(univ_col)) {
dat$university <- str_to_title(str_squish(as.character(dat[[univ_col]])))
dat$university[dat$university %in% c("", "Na", "N/A")] <- NA
} else {
dat$university <- NA
}
# Standardize field
if (!is.na(field_col)) {
dat$field <- str_to_title(str_squish(as.character(dat[[field_col]])))
dat$field[dat$field %in% c("", "Na", "N/A")] <- NA
} else {
dat$field <- NA
}
# Clean age
if (!is.na(age_col)) {
dat$age <- suppressWarnings(as.numeric(dat[[age_col]]))
dat$age[dat$age < 15 | dat$age > 60] <- NA
} else {
dat$age <- NA
}
# ---- EXCLUDE NON-LIKERT NUMERIC FIELDS -----------------------------------
# Fields to explicitly exclude from Likert analysis (siblings, semester, counts, etc.)
EXCLUDE_NUMERIC_COLS <- c("siblings", "semester", "devices", "count", "number",
"year", "student_number", "id", "batch", "canteen", "mess",
"cafeteria", "access", "connectivity", "facility")
# ---- Likert conversion with text-provenance tracking ----------------------
lk <- c("strongly disagree" = 1, "disagree" = 2, "neutral" = 3,
"neither agree nor disagree" = 3, "agree" = 4, "strongly agree" = 5,
"very dissatisfied" = 1, "dissatisfied" = 2, "satisfied" = 4,
"very satisfied" = 5, "very poor" = 1, "poor" = 2, "average" = 3,
"good" = 4, "very good" = 5, "excellent" = 5, "fair" = 3,
"never" = 1, "rarely" = 2, "sometimes" = 3, "often" = 4, "always" = 5,
"not at all" = 1, "slightly" = 2, "moderately" = 3, "very" = 4,
"extremely" = 5)
to_num <- function(x) {
v <- if (is.numeric(x)) x else unname(lk[tolower(trimws(as.character(x)))])
v <- as.numeric(v)
v[!is.na(v) & (v < 1 | v > 5)] <- NA
v
}
raw_likert <- grep("^q[0-9]+_[0-9]+_", names(dat), value = TRUE)
raw_likert <- raw_likert[!grepl("_num$", raw_likert)]
# EXCLUDE non-Likert numeric columns
raw_likert <- raw_likert[!grepl(paste(EXCLUDE_NUMERIC_COLS, collapse = "|"), tolower(raw_likert), ignore.case = TRUE)]
likert_text_cols <- character(0)
for (cl in raw_likert) {
is_text_col <- !is.numeric(dat[[cl]])
cv <- to_num(dat[[cl]])
if (sum(!is.na(cv)) >= 30) {
newcol <- paste0(cl, "_num")
dat[[newcol]] <- cv
if (is_text_col) likert_text_cols <- c(likert_text_cols, newcol)
}
}
num_cols <- likert_text_cols
# ---- Build pillar indices ---------------------------------------------------
blocks_all <- split(num_cols, str_extract(num_cols, "^q[0-9]+_[0-9]+"))
blocks_multi <- blocks_all[sapply(blocks_all, length) >= 2]
blocks <- if (length(blocks_multi) >= 4) blocks_multi else blocks_all
label_for <- function(cols, pref) {
stem <- cols %>% str_remove("_num$") %>% str_remove(paste0("^", pref, "_[0-9]+_"))
stem <- str_remove(stem, "^([0-9]+[_ ]*)+")
w <- unlist(str_split(stem, "_"))
w <- w[nchar(w) > 2]
if (!length(w)) return(toupper(pref))
# Professional label mapping
professional_terms <- c(
"academic" = "Academic Experience", "teaching" = "Teaching Quality",
"facility" = "Campus Facilities", "support" = "Student Support",
"learning" = "Learning Environment", "engagement" = "Student Engagement",
"satisfaction" = "Overall Satisfaction", "curriculum" = "Curriculum Quality",
"infrastructure" = "Infrastructure", "experience" = "Student Experience",
"counseling" = "Counseling Services", "career" = "Career Development"
)
top_word <- tolower(names(sort(table(w), decreasing = TRUE))[1])
if (top_word %in% names(professional_terms)) {
return(professional_terms[top_word])
}
str_to_title(names(sort(table(w), decreasing = TRUE))[1])
}
row_index <- function(d, cols) {
m <- suppressWarnings(apply(as.matrix(d[, cols, drop = FALSE]), 2, as.numeric))
if (is.null(dim(m))) m <- matrix(m, ncol = 1)
o <- rowMeans(m, na.rm = TRUE) * 20
o[rowSums(!is.na(m)) == 0] <- NA_real_
pmin(100, pmax(0, o))
}
idx_tbl <- tibble(prefix = names(blocks)) %>%
mutate(label = map2_chr(blocks, prefix, label_for), var = paste0("idx_", prefix))
for (i in seq_len(nrow(idx_tbl))) {
dat[[idx_tbl$var[i]]] <- row_index(dat, blocks[[idx_tbl$prefix[i]]])
}
dat$idx_overall <- row_index(dat, num_cols)
idx_tbl <- bind_rows(idx_tbl, tibble(prefix = "all", label = "Overall Experience", var = "idx_overall"))
idx_tbl <- idx_tbl[sapply(idx_tbl$var, function(v) sum(!is.na(dat[[v]]))) >= 50, ]
idx_tbl <- idx_tbl[order(-sapply(idx_tbl$var, function(v) mean(dat[[v]], na.rm = TRUE))), ]
IDX <- idx_tbl$var
LAB <- setNames(idx_tbl$label, idx_tbl$var)
PILLARS <- setdiff(IDX, "idx_overall")
# EXCLUDE unprofessional pillars and non-Likert contamination
EXCLUDE_PILLAR_LABELS <- c("canteen", "access", "connectivity", "mess", "cafeteria",
"facility", "siblings", "semester", "devices")
PILLARS <- PILLARS[!tolower(LAB[PILLARS]) %in% tolower(EXCLUDE_PILLAR_LABELS)]
# Ensure Overall is separate and prominent
PILLARS <- PILLARS[!grepl("overall|overall_experience", tolower(LAB[PILLARS]))]
rate_word <- function(m) {
case_when(m >= 80 ~ "Excellent", m >= 65 ~ "Good",
m >= 50 ~ "Satisfactory", m >= 35 ~ "Needs Improvement", TRUE ~ "Critical")
}
# ---- Summary numbers --------------------------------------------------------
total_students <- nrow(dat)
avg_overall     <- if (sum(!is.na(dat$idx_overall)) > 0) round(mean(dat$idx_overall, na.rm = TRUE), 1) else NA
n_indices       <- length(PILLARS)
n_institutions  <- if (sum(!is.na(dat$university)) > 0) n_distinct(dat$university, na.rm = TRUE) else NA
# ---- Pillar summary table ---------------------------------------------------
pillar_tbl <- NULL
if (length(PILLARS) > 0) {
pillar_tbl <- map_dfr(PILLARS, function(v) {
x <- dat[[v]][!is.na(dat[[v]])]
tibble(Pillar = LAB[[v]], N = length(x), Score = round(mean(x), 1))
}) %>%
mutate(`Variance from Overall` = round(Score - avg_overall, 1),
Rating = rate_word(Score)) %>%
arrange(desc(Score))
overall_row <- tibble(Pillar = "Overall Experience", N = sum(!is.na(dat$idx_overall)),
Score = avg_overall, `Variance from Overall` = 0,
Rating = rate_word(avg_overall))
pillar_tbl <- bind_rows(pillar_tbl, overall_row)
}
# ---- Risk segmentation (adaptive 5-band) -----------------------------------
risk_tbl <- NULL
if (sum(!is.na(dat$idx_overall)) >= 50) {
qs <- quantile(dat$idx_overall, probs = c(.2, .4, .6, .8), na.rm = TRUE, type = 7)
qs <- unique(qs)
if (length(qs) == 4) {
breaks_use <- c(-Inf, qs, Inf)
labels_use <- c("Critical", "At risk", "Stable", "Thriving", "Excelling")
} else {
breaks_use <- c(-Inf, median(dat$idx_overall, na.rm = TRUE), Inf)
labels_use <- c("Below median", "Above median")
}
dat$risk_band <- cut(dat$idx_overall, breaks = breaks_use, labels = labels_use,
include.lowest = TRUE)
risk_tbl <- dat %>%
filter(!is.na(risk_band)) %>%
count(Segment = risk_band) %>%
mutate(Share = round(100 * n / sum(n), 1))
}
# ---- Sample composition ------------------------------------------------------
comp_rows <- list()
if (sum(!is.na(dat$sector)) >= 20) {
comp_rows[["Public Institutions"]] <- round(100 * mean(dat$sector == "Public", na.rm = TRUE), 1)
comp_rows[["Private Institutions"]] <- round(100 * mean(dat$sector == "Private", na.rm = TRUE), 1)
}
if (sum(!is.na(dat$gender)) >= 20) {
comp_rows[["Female Students"]] <- round(100 * mean(dat$gender == "Female", na.rm = TRUE), 1)
comp_rows[["Male Students"]] <- round(100 * mean(dat$gender == "Male", na.rm = TRUE), 1)
}
comp_tbl <- NULL
if (length(comp_rows) > 0) {
comp_tbl <- tibble(Demographic = names(comp_rows), `Percentage (%)` = unlist(comp_rows))
}
# ---- Institution ranking table ------------------------------------------------
uni_tbl <- NULL
if (sum(!is.na(dat$university)) >= 50 && sum(!is.na(dat$idx_overall)) >= 50) {
uni_tbl <- dat %>%
filter(!is.na(university), !is.na(idx_overall)) %>%
group_by(University = university) %>%
summarise(Students = n(), `Satisfaction Score` = round(mean(idx_overall), 1),
.groups = "drop") %>%
filter(Students >= 5) %>%
arrange(desc(`Satisfaction Score`)) %>%
mutate(Rating = rate_word(`Satisfaction Score`),
Rank = row_number())
}
# ---- Field ranking table -------------------------------------------------------
field_tbl <- NULL
if (sum(!is.na(dat$field)) >= 50 && sum(!is.na(dat$idx_overall)) >= 50) {
field_tbl <- dat %>%
filter(!is.na(field), !is.na(idx_overall)) %>%
group_by(`Field of Study` = field) %>%
summarise(Students = n(), `Satisfaction Score` = round(mean(idx_overall), 1),
.groups = "drop") %>%
filter(Students >= 10) %>%
arrange(desc(`Satisfaction Score`)) %>%
mutate(Rating = rate_word(`Satisfaction Score`))
}
# ---- Group comparison (priority: Sector, then Gender) --------
group_var <- NULL
group_label <- NULL
group_palette <- NULL
group_title <- NULL
if (sum(!is.na(dat$sector)) >= 50) {
group_var <- "sector"; group_label <- "Sector"
group_palette <- sect_colors
group_title <- "Institutional Type Comparison — Key Dimensions"
} else if (sum(!is.na(dat$gender)) >= 50) {
group_var <- "gender"; group_label <- "Gender"
group_palette <- gender_colors
group_title <- "Gender Comparison — Key Dimensions"
}
group_idx_tbl <- NULL
if (!is.null(group_var) && length(PILLARS) >= 1) {
group_idx_tbl <- map_dfr(PILLARS, function(v) {
dat %>%
filter(!is.na(.data[[group_var]]), !is.na(.data[[v]])) %>%
group_by(Group = .data[[group_var]]) %>%
summarise(Mean = round(mean(.data[[v]]), 1), .groups = "drop") %>%
mutate(Dimension = LAB[[v]])
})
}
# ---- Correlation matrix for best pair --------
CM <- NULL
best_pair <- NULL
if (length(PILLARS) >= 2) {
CM <- cor(dat[, PILLARS], use = "pairwise.complete.obs")
cm_abs <- abs(CM)
diag(cm_abs) <- NA
if (all(is.na(cm_abs))) {
best_pair <- PILLARS[1:2]
} else {
best_cell <- which(cm_abs == max(cm_abs, na.rm = TRUE), arr.ind = TRUE)[1, ]
best_pair <- c(rownames(CM)[best_cell[1]], colnames(CM)[best_cell[2]])
}
}
# ---- Scatter point colouring (Sector -> Gender -> Risk) ----
point_var <- NULL
point_label <- NULL
point_palette <- NULL
if (sum(!is.na(dat$sector)) >= 50) {
point_var <- "sector"; point_label <- "Sector"; point_palette <- sect_colors
} else if (sum(!is.na(dat$gender)) >= 50) {
point_var <- "gender"; point_label <- "Gender"; point_palette <- gender_colors
} else if (!is.null(risk_tbl)) {
point_var <- "risk_band"; point_label <- "Segment"; point_palette <- band_colors_5
}
# ============================================================================
# ITEM-LEVEL DIAGNOSTICS (professional labeling, no non-Likert fields)
# ============================================================================
item_diag <- NULL
if (length(num_cols) >= 5) {
item_label_of <- function(col) {
stem <- col %>% str_remove("_num$") %>% str_remove("^q[0-9]+_[0-9]+_")
stem <- str_remove(stem, "^([0-9]+[_ ]*)+")      # Remove leading numbers
stem <- str_replace_all(stem, "_", " ")
stem <- str_squish(stem)                          # Remove extra spaces
stem <- str_trim(stem)                            # Trim edges
# Remove any remaining numeric prefixes or suffixes
stem <- gsub("^\\d+\\.?\\s*", "", stem)          # Remove "1. ", "1) ", etc.
stem <- gsub("\\s*\\d+$", "", stem)              # Remove trailing numbers
stem <- str_squish(stem)
lbl <- str_to_sentence(stem)
if (nchar(lbl) < 2) return(col)
lbl
}
item_diag <- tibble(var = num_cols) %>%
mutate(
prefix  = str_extract(var, "^q[0-9]+_[0-9]+"),
idx_var = paste0("idx_", prefix),
Dimension = unname(LAB[idx_var]),
Dimension = ifelse(is.na(Dimension), "Other", Dimension),
Statement = map_chr(var, item_label_of),
N = map_int(var, ~ sum(!is.na(dat[[.x]]))),
Mean = map_dbl(var, ~ mean(dat[[.x]], na.rm = TRUE)),
`Agreement %` = map_dbl(var, function(cl) {
v <- dat[[cl]]; v <- v[!is.na(v)]
if (length(v) == 0) NA_real_ else round(100 * mean(v >= 4), 1)
}),
`Disagreement %` = map_dbl(var, function(cl) {
v <- dat[[cl]]; v <- v[!is.na(v)]
if (length(v) == 0) NA_real_ else round(100 * mean(v <= 2), 1)
}),
`Net Sentiment` = round((`Agreement %` - `Disagreement %`), 1),
`Performance Index` = round(Mean * 20, 1),
Correlation = map_dbl(var, function(cl) {
both <- !is.na(dat[[cl]]) & !is.na(dat$idx_overall)
if (sum(both) < 20) return(NA_real_)
tryCatch(cor(dat[[cl]][both], dat$idx_overall[both]),
error = function(e) NA_real_)
})
) %>%
filter(N >= 30, !is.na(`Net Sentiment`))
item_diag$Statement <- make.unique(item_diag$Statement)
if (nrow(item_diag) == 0) item_diag <- NULL
}
avg_perf <- if (!is.null(item_diag)) mean(item_diag$`Performance Index`, na.rm = TRUE) else NA
avg_corr <- if (!is.null(item_diag)) mean(item_diag$Correlation, na.rm = TRUE) else NA
if (!is.null(item_diag)) {
item_diag <- item_diag %>%
mutate(Priority = case_when(
`Performance Index` <  avg_perf & Correlation >= avg_corr ~ "Priority",
`Performance Index` >= avg_perf & Correlation >= avg_corr ~ "Maintain",
`Performance Index` <  avg_perf & Correlation <  avg_corr ~ "Monitor",
TRUE ~ "Optimize"
))
}
valueBox(comma(total_students), icon = "fa-users", color = INK)
valueBox(ifelse(is.na(n_institutions), "N/A", comma(n_institutions)),
icon = "fa-building", color = MUTED)
valueBox(ifelse(is.na(avg_overall), "N/A", paste0(avg_overall, "/100")),
icon = "fa-check-circle", color = HIGH)
valueBox(n_indices, icon = "fa-chart-bar", color = MID)
if (!is.null(pillar_tbl)) {
dt <- datatable(pillar_tbl %>% select(-contains("var")),
rownames = FALSE,
options = list(dom = "t", pageLength = 20, scrollX = TRUE)) %>%
formatStyle("Pillar", fontWeight = styleEqual("Overall Experience", "bold"),
fontSize = "13px") %>%
formatStyle("Variance from Overall",
color = styleInterval(0, c(LOW, HIGH)),
fontWeight = "bold") %>%
formatStyle("Rating",
backgroundColor = styleEqual(
c("Critical", "Needs Improvement", "Satisfactory", "Good", "Excellent"),
c("#F6D9DA", "#FBEAD2", "#FFF4D6", "#DCEEE7", "#C8E6D9")))
dt
} else {
datatable(data.frame(Note = "Insufficient data to generate dimension indices"),
rownames = FALSE, options = list(dom = "t"))
}
